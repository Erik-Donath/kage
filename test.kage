# Read one character
Rei 1234

# ASCII code of '0' is 48
743902 yami 48
3141592 YAMI 1234 - 743902

# If not '0', jump to print
HIKARI printOneInf 3141592

# terminate
rei 0

# Label 'printOneInf'
hikari printOneInf

# Print the input
rei 1234

# Loop back
Hikari printOneInf

# --- unexpected characters ---
@ $ ! ? ,
my_label
é

# --- integer out of range ---
2147483648
-2147483649
99999999999999999999

# --- label too long (32 letters) ---
hikari abcdefghijklmnopqrstuvwxyzabcdef

# --- valid boundary values: these must NOT produce errors ---
2147483647 -2147483648
abcdefghijklmnopqrstuvwxyzabcde